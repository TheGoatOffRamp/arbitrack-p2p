# Modo multiusuario (web pública). Sin DATABASE_URL, ArbiTrack corre en modo local de un solo usuario.
DATABASE_URL=postgres://usuario:contraseña@host:5432/arbitrack
# Clave para cifrar las API keys de todos los usuarios. Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala en un lugar seguro: si se pierde, los usuarios tendrán que volver a conectar sus exchanges.
ARBITRACK_SECRET=
ARBITRACK_PUBLIC_URL=https://tu-dominio.com
ARBITRACK_TRUST_PROXY=1
NODE_ENV=production
ARBITRACK_TZ=America/Lima
# Emails (recuperación de contraseña) con https://resend.com
RESEND_API_KEY=
MAIL_FROM=ArbiTrack <no-responder@tu-dominio.com>
# Alternativa sin dominio propio: Gmail con contraseña de aplicación
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
